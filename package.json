{
  "name": "@amilochau/core-vue3-root",
  "version": "0.8.21",
  "private": true,
  "scripts": {
    "serve": "pnpm --filter @amilochau/core-vue3-playground serve",
    "build": "pnpm --filter @amilochau/core-vue3-playground build",
    "build:libs": "pnpm --filter @amilochau/core-vue3 build && pnpm --filter @amilochau/core-vue3-auth build && pnpm --filter @amilochau/core-vue3-pwa build",
    "preview": "pnpm --filter @amilochau/core-vue3-playground preview",
    "serve:auth": "pnpm --filter @amilochau/core-vue3-playground-auth serve",
    "build:auth": "pnpm --filter @amilochau/core-vue3-playground-auth build",
    "preview:auth": "pnpm --filter @amilochau/core-vue3-playground-auth preview",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tsconfig/node22": "^22.0.1",
    "@vue/tsconfig": "^0.7.0",
    "minimatch": "^10.0.1",
    "vue-component-type-helpers": "^2.2.8"
  }
}
