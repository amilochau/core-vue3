    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.13"
  },
  "devDependencies": {
    "@amilochau/core-vue3-v2": "file:packages/core-vue3-v2",
    "@intlify/unplugin-vue-i18n": "^6.0.3",
