{
  "name": "@amilochau/core-vue3-v2-auth",
  "version": "0.9.0",
  "description": "Core plugin for vue.js (v3) projects, for auth support",
  "author": "Antoine Milochau",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amilochau/core-vue3.git",
    "directory": "packages/core-vue3"
  },
  "keywords": [
    "vuejs",
    "plugin"
  ],
  "homepage": "https://github.com/amilochau/core-vue3#readme",
  "bugs": {
    "url": "https://github.com/amilochau/core-vue3/issues"
  },
  "funding": "https://github.com/sponsors/amilochau",
  "company": "Milochau",
  "copyright": "Copyright © Milochau",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "styles": "./dist/styles.css",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc --noEmit && vite build"
  },
  "files": [
    "dist"
  ],
  "exports": {
