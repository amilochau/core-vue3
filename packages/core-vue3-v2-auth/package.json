    "@stylistic/eslint-plugin": "^4.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vueuse/core": "^12.7.0",
    "aws-amplify": "^6.13.2",
    "deepmerge": "^4.3.1",
    "eslint": "^9.21.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-vue": "^9.32.0",
    "pinia": "^3.0.1",
    "sass": "^1.85.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.1",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8",
    "vuetify": "^3.7.14"
  }
