{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "env.d.ts",
    "src/**/*",
    "eslint.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
